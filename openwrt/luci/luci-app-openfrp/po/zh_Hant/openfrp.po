msgstr "TLS 處理方式"

msgid "TLS on the control connection"
msgstr "控制連線啟用 TLS"

msgid "TTL"
msgstr "TTL"

msgid "Terminate at the server (needs a pushed certificate)"
msgstr "在伺服器終止（需要推送憑證）"

msgid "Test"
msgstr "測試"

msgid "Testing credentials"
msgstr "正在測試憑證"

msgid "The LAN host running the service."
msgstr "執行該服務的內網主機。"

msgid "The account needs a name."
msgstr "帳號必須有名稱。"

msgid "The address is answered directly, which is what a tunnel needs."
msgstr "直接回傳該位址，這正是通道所需要的。"

msgid "The authority requires one, and uses it for expiry warnings."
msgstr "憑證頒發機構要求填寫，並用於到期提醒。"

msgid "The certificate was issued."
msgstr "憑證已簽發。"

msgid "The daemon writes to syslog through procd."
msgstr "守護行程透過 procd 寫入 syslog。"

msgid "The first server"
msgstr "第一台伺服器"

msgid "The port the server will listen on for this router."
msgstr "伺服器為本路由器監聽的連接埠。"

msgid "The shared secret the server was configured with."
msgstr "伺服器設定的共用金鑰。"

msgid "This account manages no zones."
msgstr "該帳號下沒有網域。"

msgid "This server has no domain yet — set it up again."
msgstr "這台伺服器還沒有域名 — 請重新設定。"

msgid "This takes a few minutes: the authority has to see the DNS record propagate before it will issue."
msgstr "這需要幾分鐘：憑證頒發機構必須先看到 DNS 記錄生效才會簽發。"

msgid "This zone has no records."
msgstr "該網域下沒有解析記錄。"

msgid "Token"
msgstr "權杖"

msgid "Total traffic"
msgstr "總流量"

msgid "Transport"
msgstr "傳輸方式"

msgid "Tunnel"
msgstr "通道"

msgid "Tunnel %s"
msgstr "隧道 %s"

msgid "Tunnels"
msgstr "通道"

msgid "Type"
msgstr "類型"

msgid "Upload"
msgstr "上行"

msgid "Uploaded to the server. Works without outbound internet there, and installs the exact bytes this router checksummed."
msgstr "上傳到伺服器。伺服器無需能連線外網，且安裝的就是本路由器驗證過的那份檔案。"

msgid "Use letters, digits, dot, dash or underscore only"
msgstr "只能使用字母、數字、點、連字號或底線"

msgid "Used when the file above is missing. {arch} and {os} are substituted with what the server turns out to be."
msgstr "當上面的檔案不存在時使用。{arch} 與 {os} 會替換為實際偵測到的伺服器架構與系統。"

msgid "Value"
msgstr "記錄值"

msgid "Version"
msgstr "版本"

msgid "Visitors must present this to reach the tunnel."
msgstr "訪問者必須提供此金鑰才能連線到該通道。"

msgid "Warm connections"
msgstr "預熱連線數"

msgid "Where to find it"
msgstr "在哪裡取得"

msgid "Which server publishes this tunnel. Leave unset for the first one."
msgstr "由哪台伺服器發布這條通道。留空則用第一台。"

msgid "You already have one running. Enter its address and token."
msgstr "你已經有一台在執行，填寫它的位址和權杖即可。"

msgid "Zone"
msgstr "網域"

msgid "Zones"
msgstr "網域列表"

msgid "\"*\" is only allowed as the leftmost label"
msgstr "\"*\" 只能作為最左邊的標籤"

msgid "\"*\" must be a whole label, not part of one"
msgstr "\"*\" 必須獨佔一個標籤，不能只佔標籤的一部分"

msgid "connected"
msgstr "已連接"

msgid "does not cover this tunnel"
msgstr "不涵蓋本隧道"

msgid "no address"
msgstr "無位址"

msgid "no response"
msgstr "無回應"

msgid "none stored"
msgstr "未儲存"

msgid "not configured"
msgstr "未設定"

msgid "not connected"
msgstr "未連接"

msgid "port %s"
msgstr "連接埠 %s"

msgid "server-allocated"
msgstr "由伺服器分配"

msgid "the request failed"
msgstr "要求失敗"

msgid "unknown"
msgstr "未知"

msgid "unnamed"
msgstr "未命名"

