#!/bin/sh /etc/rc.common

START=99
STOP=10

USE_PROCD=1

PROG=/usr/bin/openfrpc
RENDER=/usr/libexec/openfrp/render
RUNDIR=/var/run/openfrp
CLOUDFLARED=/usr/lib/openfrp/cloudflared
CFDIR=/etc/openfrp/cloudflared

CONF=$RUNDIR/cloudflared.json

say() {
	logger -t openfrp-cloudflared -p daemon.err "$1"
	echo "openfrp-cloudflared: $1" >&2
}

start_service() {
	local enabled

	config_load openfrp
	config_get_bool enabled global enabled 0

	if [ "$enabled" != "1" ]; then
		say "disabled in /etc/config/openfrp"
		return 0
	fi

	CF_FOUND=0
	config_foreach count_cloudflare server
	[ "$CF_FOUND" = "1" ] || return 0

	mkdir -p "$RUNDIR"

	local rendered
	if ! rendered="$("$RENDER" "$CONF" 2>&1)"; then
		[ -n "$rendered" ] && say "$rendered"
		say "refusing to start, the configuration could not be rendered"
		return 1
	fi

	config_foreach start_cloudflared server
}

count_cloudflare() {
	local kind
	config_get kind "$1" kind
	[ "$kind" = "cloudflare" ] && CF_FOUND=1
	return 0
}

start_cloudflared() {
	local section="$1"
	local kind tunnel_id config

	config_get kind "$section" kind
	[ "$kind" = "cloudflare" ] || return 0

	config_get tunnel_id "$section" tunnel_id
	if [ -z "$tunnel_id" ]; then
		say "$section has no Cloudflare tunnel yet, skipping"
		return 0
	fi

	if [ ! -x "$CLOUDFLARED" ]; then
		say "$section needs cloudflared, which is not installed"
		return 0
	fi

	local applied
	if ! applied="$("$PROG" cftunnel apply -server "$section" -config "$CONF" \
		-binary "$CLOUDFLARED" -dir "$CFDIR" 2>&1)"; then
		say "$section could not be published to Cloudflare: $applied"
	fi

	config="$CFDIR/config-$section.yml"
	if [ ! -f "$config" ]; then

		say "$section has no configuration at $config, not starting it"
		return 0
	fi

	procd_open_instance "cloudflared-$section"
	procd_set_param command "$CLOUDFLARED" \
		--config "$config" \
		--no-autoupdate \
		tunnel run "$tunnel_id"

	procd_set_param file "$config"

	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 5
	procd_set_param pidfile "$RUNDIR/cloudflared-$section.pid"
	procd_close_instance
}

stop_service() {
	rm -f "$CONF"
}

service_triggers() {
	procd_add_reload_trigger "openfrp"
}
