#!/bin/sh

[ -n "$(uci -q get openfrp.deploy)" ] || exit 0

carry() {
	local value
	value="$(uci -q get "openfrp.deploy.$1")"
	[ -n "$value" ] || return 0
	[ -z "$(uci -q get "openfrp.server.$2")" ] || return 0
	uci -q set "openfrp.server.$2=$value"
}

carry host            ssh_host
carry port            ssh_port
carry user            ssh_user
carry auth            ssh_auth
carry key_path        ssh_key_path
carry host_fingerprint host_fingerprint
carry binary_path     binary_path
carry release_url     release_url

uci -q delete openfrp.deploy
uci -q commit openfrp

exit 0
