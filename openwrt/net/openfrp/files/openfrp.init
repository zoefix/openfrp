#!/bin/sh /etc/rc.common
#
# procd service for the OpenFrp client.
#
# shellcheck shell=ash disable=SC2034
#

# After network. The daemon retries with backoff, so a slightly early start is
# survivable, but there is no reason to make it work for it.
START=99
STOP=10

USE_PROCD=1

PROG=/usr/bin/openfrpc
RENDER=/usr/libexec/openfrp/render
CONF=/var/etc/openfrp.json
RUNDIR=/var/run/openfrp
CLOUDFLARED=/usr/lib/openfrp/cloudflared
CFDIR=/etc/openfrp/cloudflared

# say records a diagnostic where it can be found afterwards.
#
# stderr alone was not enough. procd runs this script for a reload triggered by
# a configuration apply, and its stderr goes nowhere anybody looks — a refusal
# to start left no trace at all, so the whole service could be down for half an
# hour with the interface reporting that the apply had succeeded. syslog is
# where the rest of this project's output already goes, and is what the status
# page reads.
#
# Still echoed as well, so running the script by hand shows it on the terminal.
say() {
	logger -t openfrp -p daemon.err "$1"
	echo "openfrp: $1" >&2
}

boot() {
	# The config lives on tmpfs, so it has to be regenerated every boot.
	start "$@"
}

start_service() {
	local enabled log_level

	config_load openfrp
	config_get_bool enabled global enabled 0
	config_get log_level global log_level "info"

	if [ "$enabled" != "1" ]; then
		say "disabled in /etc/config/openfrp"
		return 0
	fi

	mkdir -p "$RUNDIR"

	# The renderer's own complaints are captured rather than left on a stderr
	# nobody reads: they name the tunnel or the setting at fault, which is the
	# whole of the diagnosis.
	local rendered
	if ! rendered="$("$RENDER" "$CONF" 2>&1)"; then
		[ -n "$rendered" ] && say "$rendered"
		say "refusing to start, the configuration could not be rendered"
		return 1
	fi
	[ -n "$rendered" ] && say "$rendered"

	# Validate before handing the config to procd. Without this a bad setting
	# becomes a respawn loop that has to be dug out of syslog; with it the
	# reason is printed once, here, next to the change that caused it.
	# The reason is captured, not discarded. Validation has always named the
	# field or setting at fault; it named it on a stderr that goes nowhere on
	# this path, so the whole diagnosis was produced and then thrown away.
	local invalid
	if ! invalid="$("$PROG" validate -c "$CONF" -q 2>&1)"; then
		say "refusing to start: $invalid"
		return 1
	fi

	# The credentials file is world-readable by default and holds an auth
	# token plus, potentially, an SSH password.
	chmod 600 /etc/config/openfrp 2>/dev/null

	procd_open_instance openfrp
	procd_set_param command "$PROG" run -c "$CONF"

	# procd hashes this file and restarts the instance when it changes, so a
	# `reload` that produces different JSON takes effect without extra wiring.
	procd_set_param file "$CONF"

	# stdout and stderr go to syslog, which is where the LuCI status view
	# reads them from. Cheapest possible log pipeline.
	procd_set_param stdout 1
	procd_set_param stderr 1

	# Restart on crash, but give up if it is crash-looping: 5 failures inside
	# an hour means the config is wrong, and hammering it hides that.
	procd_set_param respawn 3600 5 5

	procd_set_param pidfile "$RUNDIR/openfrpc.pid"
	procd_close_instance

	config_foreach start_cloudflared server
}

# start_cloudflared runs one cloudflared for a Cloudflare tunnel server.
#
# A separate process because it is a separate product: cloudflared speaks
# Cloudflare's protocol to their edge, and this daemon speaks its own to an
# openfrps. Neither can carry the other's traffic, so a router publishing both
# ways runs both.
start_cloudflared() {
	local section="$1"
	local kind tunnel_id

	config_get kind "$section" kind
	[ "$kind" = "cloudflare" ] || return 0

	config_get tunnel_id "$section" tunnel_id
	if [ -z "$tunnel_id" ]; then
		say "$section has no Cloudflare tunnel yet, skipping"
		return 0
	fi

	if [ ! -x "$CLOUDFLARED" ]; then
		say "$section needs cloudflared, which is not installed"
		return 0
	fi

	# Rendering the ingress and routing the hostnames happens here rather than
	# at setup: a domain added to a tunnel afterwards needs its own DNS record,
	# and cloudflared needs to be told where the new hostname goes. Failure is
	# reported and not fatal — a name that could not be routed should not stop
	# the names that could.
	local applied
	if ! applied="$("$PROG" cftunnel apply -server "$section" -config "$CONF" \
		-binary "$CLOUDFLARED" -dir "$CFDIR" 2>&1)"; then
		say "$section could not be published to Cloudflare: $applied"
	fi

	procd_open_instance "cloudflared-$section"
	procd_set_param command "$CLOUDFLARED" \
		--config "$CFDIR/config.yml" \
		--no-autoupdate \
		tunnel run "$tunnel_id"
	procd_set_param file "$CFDIR/config.yml"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 5
	procd_set_param pidfile "$RUNDIR/cloudflared-$section.pid"
	procd_close_instance
}

stop_service() {
	rm -f "$CONF"
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "openfrp"
}
