# OpenFrp daemons plus the benchmark tooling, on a base that carries `tc` so
# the client container can shape its own uplink.
FROM golang:1.25 AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /out/ \
      ./cmd/openfrps ./cmd/openfrpc ./bench/loadgen ./bench/echo

FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends iproute2 ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/ /usr/local/bin/
# Named echo-backend so it cannot shadow the shell builtin.
RUN mv /usr/local/bin/echo /usr/local/bin/echo-backend
COPY bench/shape.sh /usr/local/bin/shape.sh
RUN chmod +x /usr/local/bin/shape.sh
