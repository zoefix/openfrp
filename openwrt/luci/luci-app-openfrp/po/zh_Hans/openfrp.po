# Chinese (Simplified) translation for luci-app-openfrp.
#
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: zh_Hans\n"
"Plural-Forms: nplurals=1; plural=0;\n"

msgid "\"*\" is only allowed as the leftmost label"
msgstr "\"*\" 只能作为最左边的标签"

msgid "\"*\" must be a whole label, not part of one"
msgstr "\"*\" 必须独占一个标签，不能只占标签的一部分"

msgid "%d days left"
msgstr "剩余 %d 天"

msgid "%d stored"
msgstr "已存 %d 项"

msgid "%s accepted the credentials."
msgstr "%s 接受了该凭据。"

msgid "%s is not in the expected format"
msgstr "%s 格式不正确"

msgid "%s is required"
msgstr "%s 不能为空"

msgid "%s is too broad; a wildcard needs a domain beneath it"
msgstr "%s 范围过大；泛域名下面必须还有一级域名"

msgid "%s issues only to accounts it already knows, so it needs a key pair created in your %s account. This is stored once and reused for every certificate from that authority."
msgstr "%s 只向它已知的账号签发，因此需要一对在你的 %s 账号里创建的密钥。它只需保存一次，之后该机构的所有证书都会复用。"

msgid "%s issues only to accounts it already knows. Create a pair in your %s account and paste it here."
msgstr "%s 只向它已知的账号签发。请在你的 %s 账号里创建一对密钥并粘贴到这里。"

msgid "%s needs an account binding"
msgstr "%s 需要账号绑定"

msgid "%s needs external account binding credentials."
msgstr "%s 需要外部账号绑定（EAB）凭据。"

msgid "A \"*\" label matches exactly one level and may appear at any depth: *.aaa.com matches www.aaa.com but not x.bb.aaa.com. Exact names win over wildcards, and deeper wildcards win over shallower ones."
msgstr "\"*\" 标签只匹配一层，可以出现在任意深度：*.aaa.com 匹配 www.aaa.com，但不匹配 x.bb.aaa.com。精确域名优先于泛域名，层级更深的泛域名优先于更浅的。"

msgid "A domain needs at least two labels, for example aaa.com"
msgstr "域名至少要有两级，例如 aaa.com"

msgid "A name is required"
msgstr "名称不能为空"

msgid "A name you will recognise, for example aliyun-main"
msgstr "一个你能认出来的名称，例如 aliyun-main"

msgid "A password is typed in when you deploy and is never stored on this router. A key is stronger, and the deployment can install one for you."
msgstr "密码在部署时输入，不会保存在本路由器上。密钥更安全，部署过程可以帮你自动安装。"

msgid "Accounts"
msgstr "账号"

msgid "Accounts here are used to manage records and to prove domain ownership when issuing certificates. A wildcard certificate can only be issued through DNS, so it needs an account."
msgstr "这里的账号用于管理解析记录，以及在签发证书时证明域名归属。泛域名证书只能通过 DNS 验证签发，因此必须配置账号。"

msgid "Add DNS account"
msgstr "添加 DNS 账号"

msgid "Add account"
msgstr "添加账号"

msgid "Add record"
msgstr "添加记录"

msgid "Already saved for %s and reused automatically. Fill these in only to replace them."
msgstr "已为 %s 保存并会自动复用。只有要替换时才需要填写。"

msgid "Another tunnel already uses the name %s"
msgstr "已有隧道使用名称 %s"

msgid "Anything still serving it will keep the copy it already has until it restarts."
msgstr "仍在使用它的服务会继续用手上那份，直到重启为止。"

msgid "Asking %s to confirm the credentials…"
msgstr "正在请 %s 校验凭据…"

msgid "Authentication"
msgstr "认证方式"

msgid "Authority"
msgstr "证书颁发机构"

msgid "Automatic"
msgstr "自动"

msgid "Both fields are required."
msgstr "两项都必须填写。"

msgid "Cancel"
msgstr "取消"

msgid "Certificate"
msgstr "证书"

msgid "Certificate management is unavailable."
msgstr "证书管理不可用。"

msgid "Certificates"
msgstr "证书"

msgid "Certificates are issued here and pushed to the server, which loads them without dropping a single connection. They are used by tunnels whose TLS handling is set to terminate at the server."
msgstr "证书在这里签发并推送到服务端，服务端会热加载，不会断开任何一条连接。TLS 处理方式设为\"在服务端终止\"的隧道会使用它们。"

msgid "Certificates issued through this account are kept, but they cannot renew until you point them at another account."
msgstr "通过该账号签发的证书会保留，但在你把它们指向其他账号之前无法续期。"

msgid "Close"
msgstr "关闭"

msgid "Connection"
msgstr "连接"

msgid "Connection pool — independent congestion windows, kernel zero-copy"
msgstr "连接池 — 各自独立的拥塞窗口，内核零拷贝"

msgid "Connections"
msgstr "连接数"

msgid "Connections kept open so an arriving request does not wait for a dial."
msgstr "预先保持的连接数，使新请求无需等待建立连接。"

msgid "Contact email"
msgstr "联系邮箱"

msgid "Control port"
msgstr "控制端口"

msgid "Could not reach the OpenFrp backend."
msgstr "无法连接到 OpenFrp 后端。"

msgid "Could not start the deployment: %s"
msgstr "无法启动部署：%s"

msgid "Could not start: %s"
msgstr "无法启动：%s"

msgid "Create"
msgstr "创建"

msgid "Credentials"
msgstr "凭据"

msgid "DNS"
msgstr "DNS"

msgid "DNS account"
msgstr "DNS 账号"

msgid "DNS management is unavailable."
msgstr "DNS 管理不可用。"

msgid "Delete"
msgstr "删除"

msgid "Delete %s?"
msgstr "确定删除 %s？"

msgid "Delete DNS account"
msgstr "删除 DNS 账号"

msgid "Delete certificate"
msgstr "删除证书"

msgid "Delete record"
msgstr "删除记录"

msgid "Delete the %s record for %s?"
msgstr "确定删除 %s 的 %s 记录？"

msgid "Delete the certificate for %s?"
msgstr "确定删除 %s 的证书？"

msgid "Deploy"
msgstr "部署"

msgid "Deploy now"
msgstr "立即部署"

msgid "Deploy server"
msgstr "部署服务端"

msgid "Deploying server"
msgstr "正在部署服务端"

msgid "Deploying to %s. This can take a few minutes."
msgstr "正在部署到 %s，可能需要几分钟。"

msgid "Detects the distribution and init system, installs the server, writes its configuration, opens the firewall and verifies the result. Safe to run again to upgrade in place."
msgstr "自动识别发行版与 init 系统，安装服务端、写入配置、放行防火墙并验证结果。可重复执行以原地升级。"

msgid "Disabled"
msgstr "已禁用"

msgid "Domains"
msgstr "域名"

msgid "Download"
msgstr "下行"

msgid "Download URL"
msgstr "下载地址"

msgid "EAB HMAC key"
msgstr "EAB HMAC 密钥"

msgid "EAB key ID"
msgstr "EAB Key ID"

msgid "Each tunnel exposes one local service through the server."
msgstr "每条隧道通过服务端暴露一个内网服务。"

msgid "Edit"
msgstr "编辑"

msgid "Edit DNS account"
msgstr "编辑 DNS 账号"

msgid "Edit record"
msgstr "编辑记录"

msgid "Empty label in %s"
msgstr "%s 中有空标签"

msgid "Enable OpenFrp"
msgstr "启用 OpenFrp"

msgid "Enabled"
msgstr "已启用"

msgid "Enabled but not running"
msgstr "已启用但未运行"

msgid "Enter a contact email address."
msgstr "请填写联系邮箱。"

msgid "Enter the SSH password."
msgstr "请输入 SSH 密码。"

msgid "Expired"
msgstr "已过期"

msgid "Exposed as"
msgstr "对外地址"

msgid "Failed"
msgstr "失败"

msgid "Failed — see the output above."
msgstr "失败 — 请查看上面的输出。"

msgid "Finished successfully."
msgstr "已成功完成。"

msgid "History"
msgstr "历史"

msgid "Host key fingerprint"
msgstr "主机密钥指纹"

msgid "If the ACL file was just installed, rpcd needs a restart: /etc/init.d/rpcd restart"
msgstr "如果 ACL 文件是刚安装的，需要重启 rpcd：/etc/init.d/rpcd restart"

msgid "Install and configure the server over SSH. The server needs nothing installed beforehand."
msgstr "通过 SSH 安装并配置服务端。服务器无需预装任何软件。"

msgid "Issuance failed — see the output above."
msgstr "签发失败 — 请查看上面的输出。"

msgid "Issue"
msgstr "签发"

msgid "Issuing certificate"
msgstr "正在签发证书"

msgid "Issuing…"
msgstr "签发中…"

msgid "Job ended in state: %s"
msgstr "任务结束状态：%s"

msgid "Key"
msgstr "密钥"

msgid "Key type"
msgstr "密钥类型"

msgid "Leave empty to let the server allocate one."
msgstr "留空则由服务端自动分配。"

msgid "Line"
msgstr "线路"

msgid "List at least one domain."
msgstr "至少填写一个域名。"

msgid "Loading records…"
msgstr "正在加载记录…"

msgid "Loading zones…"
msgstr "正在加载域名…"

msgid "Local address"
msgstr "内网地址"

msgid "Local port"
msgstr "内网端口"

msgid "Local target"
msgstr "内网目标"

msgid "Log level"
msgstr "日志级别"

msgid "Lost track of the job: %s"
msgstr "无法获取任务状态：%s"

msgid "Manual"
msgstr "手动"

msgid "Multiplex connections"
msgstr "多路复用连接"

msgid "Multiplexed — shared congestion window, no kernel zero-copy"
msgstr "多路复用 — 共享拥塞窗口，无法使用内核零拷贝"

msgid "Name"
msgstr "名称"

msgid "No DNS accounts are configured. Add one on the DNS page first — a wildcard certificate cannot be issued without it."
msgstr "尚未配置 DNS 账号。请先在 DNS 页面添加一个 —— 没有它无法签发泛域名证书。"

msgid "No DNS accounts yet. Add one to manage records and to issue wildcard certificates."
msgstr "还没有 DNS 账号。添加一个即可管理解析记录并签发泛域名证书。"

msgid "No DNS providers are available."
msgstr "没有可用的 DNS 服务商。"

msgid "No certificates have been issued yet. Request one on the Certificates page first."
msgstr "还没有签发任何证书。请先到证书页面申请一张。"

msgid "No certificates yet."
msgstr "还没有证书。"

msgid "No log output yet."
msgstr "暂无日志输出。"

msgid "No tunnels are configured yet."
msgstr "尚未配置任何隧道。"

msgid "None"
msgstr "无"

msgid "None — TLS will not work until one is bound"
msgstr "无 — 未绑定证书前 TLS 无法工作"

msgid "Not issued yet"
msgstr "尚未签发"

msgid "Nothing has happened to this certificate yet."
msgstr "该证书还没有任何记录。"

msgid "Off by default, unlike frp. Multiplexing puts every tunnel behind one congestion window, so a single lost packet stalls them all, and it rules out the kernel zero-copy path. Enable only when the number of open sockets matters more than throughput."
msgstr "与 frp 不同，此项默认关闭。多路复用会让所有隧道共用一个拥塞窗口，一个丢包就会拖住全部隧道，而且无法走内核零拷贝。只有当套接字数量比吞吐更重要时才启用。"

msgid "One per line. A \"*\" covers exactly one level, so *.aiqno.com covers acgshop.aiqno.com but not a.b.aiqno.com."
msgstr "每行一个。\"*\" 只覆盖一层，所以 *.aiqno.com 覆盖 acgshop.aiqno.com，但不覆盖 a.b.aiqno.com。"

msgid "Overview"
msgstr "概览"

msgid "Passthrough forwards the encrypted stream untouched, so the local service owns the certificate. Termination requires a certificate issued here and pushed to the server."
msgstr "透传会原样转发加密流量，证书由内网服务自己持有。终止则需要在本机签发证书并推送到服务端。"

msgid "Passthrough — the server does not decrypt"
msgstr "透传 — 服务端不解密"

msgid "Password"
msgstr "密码"

msgid "Path to a key on this router."
msgstr "本路由器上的密钥文件路径。"

msgid "Patterns routed to this tunnel over the shared HTTP and HTTPS ports."
msgstr "通过共享的 HTTP / HTTPS 端口路由到本隧道的域名模式。"

msgid "Private key"
msgstr "私钥"

msgid "Provider"
msgstr "服务商"

msgid "Provision the server"
msgstr "部署服务端"

msgid "Pushed to the server and hot-loaded, without dropping a connection. Only a bound tunnel has its certificate pushed."
msgstr "推送到服务端热加载，不会断开任何连接。只有绑定了证书的隧道才会推送。"

msgid "Recent log"
msgstr "最近日志"

msgid "Recorded on first connection and checked afterwards."
msgstr "首次连接时记录，之后每次都会校验。"

msgid "Records"
msgstr "解析记录"

msgid "Records in %s"
msgstr "%s 的解析记录"

msgid "Remote port"
msgstr "远程端口"

msgid "Renew automatically"
msgstr "自动续期"

msgid "Renew now"
msgstr "立即续期"

msgid "Renewal"
msgstr "续期"

msgid "Renews once fewer than 30 days remain."
msgstr "剩余不足 30 天时自动续期。"

msgid "Request a certificate"
msgstr "申请证书"

msgid "Required for a wildcard: only a DNS record can prove control of names that do not exist yet."
msgstr "泛域名必填：只有 DNS 记录才能证明你对尚不存在的名字有控制权。"

msgid "Running"
msgstr "运行中"

msgid "Running…"
msgstr "执行中…"

msgid "SSH host"
msgstr "SSH 主机"

msgid "SSH password"
msgstr "SSH 密码"

msgid "SSH password for %s@%s"
msgstr "%s@%s 的 SSH 密码"

msgid "SSH port"
msgstr "SSH 端口"

msgid "SSH user"
msgstr "SSH 用户"

msgid "Save"
msgstr "保存"

msgid "Save and issue"
msgstr "保存并签发"

msgid "Saved — leave blank to keep"
msgstr "已保存 — 留空则沿用"

msgid "Secret TCP"
msgstr "私密 TCP"

msgid "Secret key"
msgstr "访问密钥"

msgid "Server"
msgstr "服务端"

msgid "Server address"
msgstr "服务端地址"

msgid "Server binary"
msgstr "服务端程序"

msgid "Service"
msgstr "服务"

msgid "Set the SSH host first."
msgstr "请先填写 SSH 主机。"

msgid "Shared secret. Stored in plaintext on this router."
msgstr "共享密钥。以明文保存在本路由器上。"

msgid "Start"
msgstr "开始"

msgid "Starting…"
msgstr "正在启动…"

msgid "State"
msgstr "状态"

msgid "Stored credentials are never displayed. Leave blank to keep the current value."
msgstr "已保存的凭据不会显示。留空则保持原值。"

msgid "TLS handling"
msgstr "TLS 处理方式"

msgid "TLS on the control connection"
msgstr "控制连接启用 TLS"

msgid "TTL"
msgstr "TTL"

msgid "Terminate at the server (needs a pushed certificate)"
msgstr "在服务端终止（需要推送证书）"

msgid "Test"
msgstr "测试"

msgid "Testing credentials"
msgstr "正在测试凭据"

msgid "The LAN host running the service."
msgstr "运行该服务的内网主机。"

msgid "The account needs a name."
msgstr "账号必须有名称。"

msgid "The authority requires one, and uses it for expiry warnings."
msgstr "证书颁发机构要求填写，并用于到期提醒。"

msgid "The certificate was issued."
msgstr "证书已签发。"

msgid "The daemon writes to syslog through procd."
msgstr "守护进程通过 procd 写入 syslog。"

msgid "This account manages no zones."
msgstr "该账号下没有域名。"

msgid "This takes a few minutes: the authority has to see the DNS record propagate before it will issue."
msgstr "这需要几分钟：证书颁发机构必须先看到 DNS 记录生效才会签发。"

msgid "This zone has no records."
msgstr "该域名下没有解析记录。"

msgid "Token"
msgstr "令牌"

msgid "Total traffic"
msgstr "总流量"

msgid "Transport"
msgstr "传输方式"

msgid "Tunnel"
msgstr "隧道"

msgid "Tunnels"
msgstr "隧道"

msgid "Type"
msgstr "类型"

msgid "Upload"
msgstr "上行"

msgid "Uploaded to the server. Works without outbound internet there, and installs the exact bytes this router checksummed."
msgstr "上传到服务器。服务器无需能访问外网，且安装的就是本路由器校验过的那份文件。"

msgid "Use letters, digits, dot, dash or underscore only"
msgstr "只能使用字母、数字、点、短横线或下划线"

msgid "Used for this deployment only. It is not saved."
msgstr "仅用于本次部署，不会保存。"

msgid "Used when the file above is missing. {arch} and {os} are substituted with what the server turns out to be."
msgstr "当上面的文件不存在时使用。{arch} 与 {os} 会替换为实际探测到的服务器架构与系统。"

msgid "Value"
msgstr "记录值"

msgid "Visitors must present this to reach the tunnel."
msgstr "访问者必须提供此密钥才能连接到该隧道。"

msgid "Warm connections"
msgstr "预热连接数"

msgid "Where this router connects, and how to provision that server."
msgstr "本路由器连接到哪里，以及如何部署那台服务器。"

msgid "Where to find it"
msgstr "在哪里获取"

msgid "Zone"
msgstr "域名"

msgid "Zones"
msgstr "域名列表"

msgid "no response"
msgstr "无响应"

msgid "none stored"
msgstr "未存储"

msgid "not configured"
msgstr "未配置"

msgid "port %s"
msgstr "端口 %s"

msgid "server-allocated"
msgstr "由服务端分配"

msgid "the request failed"
msgstr "请求失败"

msgid "unnamed"
msgstr "未命名"
