# Chinese (Traditional, Taiwan) translation for luci-app-openfrp.
#
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: zh_Hant\n"
"Plural-Forms: nplurals=1; plural=0;\n"

msgid "\"*\" is only allowed as the leftmost label"
msgstr "\"*\" 只能作為最左邊的標籤"

msgid "\"*\" must be a whole label, not part of one"
msgstr "\"*\" 必須獨佔一個標籤，不能只佔標籤的一部分"

msgid "%s is not in the expected format"
msgstr "%s 格式不正確"

msgid "%s is required"
msgstr "%s 不能為空"

msgid "%s is too broad; a wildcard needs a domain beneath it"
msgstr "%s 範圍過大；泛網域下面必須還有一級網域"

msgid "A \"*\" label matches exactly one level and may appear at any depth: *.aaa.com matches www.aaa.com but not x.bb.aaa.com. Exact names win over wildcards, and deeper wildcards win over shallower ones."
msgstr "\"*\" 標籤只比對一層，可以出現在任意深度：*.aaa.com 比對 www.aaa.com，但不比對 x.bb.aaa.com。精確網域優先於泛網域，層級更深的泛網域優先於更淺的。"

msgid "A domain needs at least two labels, for example aaa.com"
msgstr "網域至少要有兩級，例如 aaa.com"

msgid "A name is required"
msgstr "名稱不能為空"

msgid "A password is typed in when you deploy and is never stored on this router. A key is stronger, and the deployment can install one for you."
msgstr "密碼在部署時輸入，不會儲存在本路由器上。金鑰更安全，部署過程可以幫你自動安裝。"

msgid "Another tunnel already uses the name %s"
msgstr "已有通道使用名稱 %s"

msgid "Authentication"
msgstr "驗證方式"

msgid "Cancel"
msgstr "取消"

msgid "Close"
msgstr "關閉"

msgid "Connection"
msgstr "連線"

msgid "Connection pool — independent congestion windows, kernel zero-copy"
msgstr "連線池 — 各自獨立的壅塞視窗，核心零複製"

msgid "Connections kept open so an arriving request does not wait for a dial."
msgstr "預先保持的連線數，使新要求無需等待建立連線。"

msgid "Control port"
msgstr "控制連接埠"

msgid "Could not reach the OpenFrp backend."
msgstr "無法連線到 OpenFrp 後端。"

msgid "Could not start the deployment: %s"
msgstr "無法啟動部署：%s"

msgid "Deploy"
msgstr "部署"

msgid "Deploy now"
msgstr "立即部署"

msgid "Deploy server"
msgstr "部署伺服器"

msgid "Deploying server"
msgstr "正在部署伺服器"

msgid "Deploying to %s. This can take a few minutes."
msgstr "正在部署到 %s，可能需要幾分鐘。"

msgid "Detects the distribution and init system, installs the server, writes its configuration, opens the firewall and verifies the result. Safe to run again to upgrade in place."
msgstr "自動識別發行版與 init 系統，安裝伺服器、寫入設定、放行防火牆並驗證結果。可重複執行以原地升級。"

msgid "Disabled"
msgstr "已停用"

msgid "Domains"
msgstr "網域"

msgid "Download URL"
msgstr "下載網址"

msgid "Each tunnel exposes one local service through the server."
msgstr "每條通道透過伺服器公開一個內網服務。"

msgid "Empty label in %s"
msgstr "%s 中有空標籤"

msgid "Enable OpenFrp"
msgstr "啟用 OpenFrp"

msgid "Enabled"
msgstr "已啟用"

msgid "Enabled but not running"
msgstr "已啟用但未執行"

msgid "Enter the SSH password."
msgstr "請輸入 SSH 密碼。"

msgid "Exposed as"
msgstr "對外位址"

msgid "Failed — see the output above."
msgstr "失敗 — 請查看上面的輸出。"

msgid "Finished successfully."
msgstr "已成功完成。"

msgid "Host key fingerprint"
msgstr "主機金鑰指紋"

msgid "If the ACL file was just installed, rpcd needs a restart: /etc/init.d/rpcd restart"
msgstr "如果 ACL 檔案是剛安裝的，需要重新啟動 rpcd：/etc/init.d/rpcd restart"

msgid "Install and configure the server over SSH. The server needs nothing installed beforehand."
msgstr "透過 SSH 安裝並設定伺服器。伺服器無需預先安裝任何軟體。"

msgid "Job ended in state: %s"
msgstr "工作結束狀態：%s"

msgid "Leave empty to let the server allocate one."
msgstr "留空則由伺服器自動分配。"

msgid "Local address"
msgstr "內網位址"

msgid "Local port"
msgstr "內網連接埠"

msgid "Local target"
msgstr "內網目標"

msgid "Log level"
msgstr "日誌等級"

msgid "Lost track of the job: %s"
msgstr "無法取得工作狀態：%s"

msgid "Multiplex connections"
msgstr "多工連線"

msgid "Multiplexed — shared congestion window, no kernel zero-copy"
msgstr "多工 — 共用壅塞視窗，無法使用核心零複製"

msgid "Name"
msgstr "名稱"

msgid "No log output yet."
msgstr "尚無日誌輸出。"

msgid "No tunnels are configured yet."
msgstr "尚未設定任何通道。"

msgid "Off by default, unlike frp. Multiplexing puts every tunnel behind one congestion window, so a single lost packet stalls them all, and it rules out the kernel zero-copy path. Enable only when the number of open sockets matters more than throughput."
msgstr "與 frp 不同，此項預設關閉。多工會讓所有通道共用一個壅塞視窗，一個封包遺失就會拖住全部通道，而且無法走核心零複製。只有當通訊端數量比傳輸量更重要時才啟用。"

msgid "Overview"
msgstr "概觀"

msgid "Passthrough forwards the encrypted stream untouched, so the local service owns the certificate. Termination requires a certificate issued here and pushed to the server."
msgstr "透傳會原樣轉發加密流量，憑證由內網服務自己持有。終止則需要在本機簽發憑證並推送到伺服器。"

msgid "Passthrough — the server does not decrypt"
msgstr "透傳 — 伺服器不解密"

msgid "Password"
msgstr "密碼"

msgid "Path to a key on this router."
msgstr "本路由器上的金鑰檔案路徑。"

msgid "Patterns routed to this tunnel over the shared HTTP and HTTPS ports."
msgstr "透過共用的 HTTP / HTTPS 連接埠路由到本通道的網域模式。"

msgid "Private key"
msgstr "私密金鑰"

msgid "Provision the server"
msgstr "部署伺服器"

msgid "Recent log"
msgstr "最近日誌"

msgid "Recorded on first connection and checked afterwards."
msgstr "首次連線時記錄，之後每次都會驗證。"

msgid "Remote port"
msgstr "遠端連接埠"

msgid "Running"
msgstr "執行中"

msgid "Running…"
msgstr "執行中…"

msgid "SSH host"
msgstr "SSH 主機"

msgid "SSH password"
msgstr "SSH 密碼"

msgid "SSH password for %s@%s"
msgstr "%s@%s 的 SSH 密碼"

msgid "SSH port"
msgstr "SSH 連接埠"

msgid "SSH user"
msgstr "SSH 使用者"

msgid "Secret TCP"
msgstr "私密 TCP"

msgid "Secret key"
msgstr "存取金鑰"

msgid "Server"
msgstr "伺服器"

msgid "Server address"
msgstr "伺服器位址"

msgid "Server binary"
msgstr "伺服器執行檔"

msgid "Service"
msgstr "服務"

msgid "Set the SSH host first."
msgstr "請先填寫 SSH 主機。"

msgid "Shared secret. Stored in plaintext on this router."
msgstr "共用金鑰。以明文儲存在本路由器上。"

msgid "Start"
msgstr "開始"

msgid "Starting…"
msgstr "正在啟動…"

msgid "State"
msgstr "狀態"

msgid "Stored credentials are never displayed. Leave blank to keep the current value."
msgstr "已儲存的憑證不會顯示。留空則保持原值。"

msgid "TLS handling"
msgstr "TLS 處理方式"

msgid "TLS on the control connection"
msgstr "控制連線啟用 TLS"

msgid "Terminate at the server (needs a pushed certificate)"
msgstr "在伺服器終止（需要推送憑證）"

msgid "The LAN host running the service."
msgstr "執行該服務的內網主機。"

msgid "The daemon writes to syslog through procd."
msgstr "守護行程透過 procd 寫入 syslog。"

msgid "Token"
msgstr "權杖"

msgid "Transport"
msgstr "傳輸方式"

msgid "Tunnel"
msgstr "通道"

msgid "Tunnels"
msgstr "通道"

msgid "Type"
msgstr "類型"

msgid "Uploaded to the server. Works without outbound internet there, and installs the exact bytes this router checksummed."
msgstr "上傳到伺服器。伺服器無需能連線外網，且安裝的就是本路由器驗證過的那份檔案。"

msgid "Use letters, digits, dot, dash or underscore only"
msgstr "只能使用字母、數字、點、連字號或底線"

msgid "Used for this deployment only. It is not saved."
msgstr "僅用於本次部署，不會儲存。"

msgid "Used when the file above is missing. {arch} and {os} are substituted with what the server turns out to be."
msgstr "當上面的檔案不存在時使用。{arch} 與 {os} 會替換為實際偵測到的伺服器架構與系統。"

msgid "Visitors must present this to reach the tunnel."
msgstr "訪問者必須提供此金鑰才能連線到該通道。"

msgid "Warm connections"
msgstr "預熱連線數"

msgid "Where this router connects, and how to provision that server."
msgstr "本路由器連線到哪裡，以及如何部署那台伺服器。"

msgid "no response"
msgstr "無回應"

msgid "not configured"
msgstr "未設定"

msgid "port %s"
msgstr "連接埠 %s"

msgid "server-allocated"
msgstr "由伺服器分配"

msgid "unnamed"
msgstr "未命名"
