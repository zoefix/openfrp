#!/bin/sh

set -e

. /usr/share/libubox/jshn.sh
. /lib/functions.sh

OUT="${1:-/var/etc/openfrp.json}"

say() {
	command -v logger >/dev/null 2>&1 && logger -t openfrp -p daemon.err "$1"
	echo "openfrp: $1" >&2
}

add_string() {
	[ -n "$2" ] || return 0
	json_add_string "$1" "$2"
}

add_int() {
	[ -n "$2" ] || return 0
	json_add_int "$1" "$2"
}

add_bool() {
	[ -n "$2" ] || return 0
	json_add_boolean "$1" "$([ "$2" = "1" ] && echo 1 || echo 0)"
}

append_domain() {
	json_add_string "" "$1"
}

CF_ZONE=""

CF_ANY=0

append_prefixed() {
	CF_ANY=1
	case "$1" in
		'@') json_add_string "" "$CF_ZONE" ;;
		*)   json_add_string "" "$1.$CF_ZONE" ;;
	esac
}

add_tunnel() {
	local section="$1"
	local name enabled type local_ip local_port remote_port tls_mode secret_key cert_id proxy_protocol server https
	local down_rate up_rate quota

	config_get name "$section" name
	config_get down_rate "$section" down_rate 0
	config_get up_rate "$section" up_rate 0
	config_get quota "$section" quota 0
	config_get_bool enabled "$section" enabled 0
	config_get type "$section" type "tcp"
	config_get local_ip "$section" local_ip "127.0.0.1"
	config_get local_port "$section" local_port
	config_get remote_port "$section" remote_port
	config_get tls_mode "$section" tls_mode
	config_get cert_id "$section" cert_id
	config_get proxy_protocol "$section" proxy_protocol
	config_get server "$section" server
	config_get_bool https "$section" https 0

	if [ "$type" = "http" ] && [ "$https" = "1" ]; then
		type="https"
		[ -n "$tls_mode" ] || tls_mode="terminate"
	fi
	config_get secret_key "$section" secret_key

	if [ -z "$name" ] || [ -z "$local_port" ]; then
		say "skipping tunnel '$section': name and local_port are required"
		return 0
	fi

	json_add_object ""
	json_add_string name "$name"

	# The form asks in the units an operator thinks in — kilobytes a second,
	# megabytes in total — and the daemon works in bytes.
	[ "${down_rate:-0}" -gt 0 ] 2>/dev/null && json_add_int down_rate $((down_rate * 1024))
	[ "${up_rate:-0}" -gt 0 ] 2>/dev/null && json_add_int up_rate $((up_rate * 1024))
	[ "${quota:-0}" -gt 0 ] 2>/dev/null && json_add_int quota $((quota * 1024 * 1024))
	json_add_boolean enabled "$enabled"
	json_add_string type "$type"
	json_add_string local_ip "$local_ip"
	json_add_int local_port "$local_port"
	add_int remote_port "$remote_port"
	add_string tls_mode "$tls_mode"

	add_int cert_id "$cert_id"

	add_string proxy_protocol "$proxy_protocol"

	add_string server "$server"
	add_string secret_key "$secret_key"

	local owner owner_kind zone prefix
	owner="$server"
	[ -n "$owner" ] || owner="$FIRST_SERVER"
	config_get owner_kind "$owner" kind

	if [ "$owner_kind" = "cloudflare" ]; then
		config_get zone "$owner" zone
		config_get prefix "$section" cf_prefix

		if [ -n "$zone" ]; then
			json_add_array domains
			if [ -n "$prefix" ]; then
				CF_ZONE="$zone"
				CF_ANY=0
				config_list_foreach "$section" cf_prefix append_prefixed

				[ "$CF_ANY" = "0" ] && append_prefixed "$prefix"
			else

				json_add_string "" "$zone"
			fi
			json_close_array
		else
			say "tunnel '$section' is on $owner, which has no domain yet"
		fi

		json_close_object
		return 0
	fi

	local domains
	config_get domains "$section" domains
	if [ -n "$domains" ]; then
		json_add_array domains
		config_list_foreach "$section" domains append_domain
		json_close_array
	fi

	json_close_object
}

SERVER_COUNT=0

FIRST_SERVER=""

add_server() {
	local section="$1"
	local addr port token protocol mux pool_count tls_enable client_name
	local direct_egress
	local kind tunnel_id zone

	config_get kind "$section" kind

	if [ "$kind" = "cloudflare" ]; then
		config_get tunnel_id "$section" tunnel_id
		[ -n "$tunnel_id" ] || return 0

		SERVER_COUNT=$((SERVER_COUNT + 1))
		[ -n "$FIRST_SERVER" ] || FIRST_SERVER="$section"
		json_add_object ""
		json_add_string name "$section"
		json_add_string kind cloudflare
		json_add_string tunnel_id "$tunnel_id"
		config_get zone "$section" zone
		add_string zone "$zone"
		json_close_object
		return 0
	fi

	config_get addr "$section" addr
	[ -n "$addr" ] || return 0

	config_get port "$section" port "7000"
	config_get token "$section" token
	config_get protocol "$section" protocol "tcp"
	config_get_bool mux "$section" mux 0
	config_get pool_count "$section" pool_count "8"
	config_get_bool tls_enable "$section" tls_enable 0
	config_get client_name "$section" client_name
	config_get_bool direct_egress "$section" direct_egress 0

	SERVER_COUNT=$((SERVER_COUNT + 1))
	[ -n "$FIRST_SERVER" ] || FIRST_SERVER="$section"

	json_add_object ""

	json_add_string name "$section"
	json_add_string addr "$addr"
	json_add_int port "$port"
	add_string token "$token"
	add_string client_name "$client_name"

	if [ "$direct_egress" = "1" ]; then
		json_add_int socket_gid 65534
		json_add_int socket_mark 8451
	fi

	json_add_object transport
	json_add_string protocol "$protocol"
	json_add_boolean mux "$mux"
	json_add_int pool_count "$pool_count"
	json_add_boolean tls_enable "$tls_enable"
	json_close_object

	json_close_object
}

main() {
	local log_level

	config_load openfrp

	config_get log_level global log_level "info"

	json_init

	json_add_array servers
	config_foreach add_server server
	json_close_array

	if [ "$SERVER_COUNT" -eq 0 ]; then
		say "no server is configured"
		return 1
	fi

	json_add_array tunnels
	config_foreach add_tunnel tunnel
	json_close_array

	json_add_object log
	json_add_string level "$log_level"
	json_add_string format "text"
	json_close_object

	mkdir -p "$(dirname "$OUT")"

	umask 077
	json_dump > "$OUT.tmp"
	mv "$OUT.tmp" "$OUT"
}

main "$@"
