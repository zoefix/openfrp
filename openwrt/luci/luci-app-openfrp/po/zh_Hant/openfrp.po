msgid "%d days left"
msgstr "剩餘 %d 天"

msgid "%d stored"
msgstr "已存 %d 項"

msgid "%s accepted the credentials."
msgstr "%s 接受了該憑證。"

msgid "%s is not in the expected format"
msgstr "%s 格式不正確"

msgid "%s is required"
msgstr "%s 不能為空"

msgid "%s is too broad; a wildcard needs a domain beneath it"
msgstr "%s 範圍過大；泛網域下面必須還有一級網域"

msgid "%s needs a key pair from your %s account."
msgstr "%s 需要一對來自你 %s 帳戶的金鑰。"

msgid "%s needs an account binding"
msgstr "%s 需要帳號綁定"

msgid "%s needs external account binding credentials."
msgstr "%s 需要外部帳號綁定（EAB）憑證。"

msgid "A Cloudflare tunnel publishes over HTTP. Use a server of your own for %s."
msgstr "Cloudflare 隧道只走 HTTP。需要 %s 請改用自己的伺服器。"

msgid "A domain needs at least two labels, for example aaa.com"
msgstr "網域至少要有兩級，例如 aaa.com"

msgid "A high-performance NAT traversal service, written in Go on Linux zero-copy, with wildcard domain routing and automatic certificates."
msgstr "基於 Go 與 Linux 零複製實現的高效能內網穿透服務，支援泛網域路由與自動憑證。"

msgid "A name is required"
msgstr "名稱不能為空"

msgid "A name you will recognise, for example aliyun-main"
msgstr "一個你能認出來的名稱，例如 aliyun-main"

msgid "A wildcard can only be proved through DNS."
msgstr "泛網域只能透過 DNS 驗證。"

msgid "A wildcard can only be proved through DNS. Select an account."
msgstr "泛網域只能透過 DNS 驗證，請選擇一個帳號。"

msgid "About"
msgstr "關於"

msgid "Accounts"
msgstr "帳號"

msgid "Add"
msgstr "新增"

msgid "Add DNS account"
msgstr "新增 DNS 帳號"

msgid "Add a domain to this tunnel first."
msgstr "請先給這條通道新增網域。"

