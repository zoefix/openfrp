#!/bin/sh /etc/rc.common

START=99
STOP=10

USE_PROCD=1

PROG=/usr/bin/openfrpc
RENDER=/usr/libexec/openfrp/render
CONF=/var/etc/openfrp.json
RUNDIR=/var/run/openfrp

say() {
	logger -t openfrp -p daemon.err "$1"
	echo "openfrp: $1" >&2
}

boot() {
	start "$@"
}

start_service() {
	local enabled log_level

	config_load openfrp
	config_get_bool enabled global enabled 0
	config_get log_level global log_level "info"

	if [ "$enabled" != "1" ]; then
		say "disabled in /etc/config/openfrp"
		return 0
	fi

	mkdir -p "$RUNDIR"

	local rendered
	if ! rendered="$("$RENDER" "$CONF" 2>&1)"; then
		[ -n "$rendered" ] && say "$rendered"
		say "refusing to start, the configuration could not be rendered"
		return 1
	fi
	[ -n "$rendered" ] && say "$rendered"

	local invalid
	if ! invalid="$("$PROG" validate -c "$CONF" -q 2>&1)"; then
		say "refusing to start: $invalid"
		return 1
	fi

	chmod 600 /etc/config/openfrp 2>/dev/null

	procd_open_instance openfrp
	procd_set_param command "$PROG" run -c "$CONF"

	procd_set_param file "$CONF"

	procd_set_param stdout 1
	procd_set_param stderr 1

	procd_set_param respawn 3600 5 5

	procd_set_param pidfile "$RUNDIR/openfrpc.pid"
	procd_close_instance
}

stop_service() {
	rm -f "$CONF"
}

service_triggers() {
	procd_add_reload_trigger "openfrp"
}
