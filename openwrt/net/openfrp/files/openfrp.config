#
# OpenFrp client configuration.
#
# Structured data — DNS accounts, certificate orders, resolution records —
# lives in SQLite rather than here. UCI holds what an operator edits by hand
# and what should survive a firmware backup.
#

config global 'global'
	option enabled '0'
	option log_level 'info'

config server 'server'
	option addr ''
	option port '7000'
	option token ''
	# tcp | kcp | quic | websocket
	option protocol 'tcp'
	# Multiplexing is off by default, unlike frp. Every tunnel gets its own
	# TCP connection, which keeps the kernel zero-copy path reachable and
	# stops one lost packet from stalling every tunnel at once. Enable only
	# if socket count matters more than throughput.
	option mux '0'
	option pool_count '8'
	option tls_enable '0'

# Settings for provisioning the server over SSH.
#
# There is deliberately no password option. LuCI asks for the SSH password at
# deployment time and passes it straight through to the job, so it never
# reaches disk. Anything stored here is plaintext — /etc/config/openfrp is
# chmod 600, but it is readable by root and it survives firmware backups.
#
# auth: password | key
config ssh 'deploy'
	option host ''
	option port '22'
	option user 'root'
	option auth 'password'
	option key_path ''
	option host_fingerprint ''
	# Server binary uploaded to the remote host. Uploading beats downloading:
	# it works on a server with no outbound internet and installs the exact
	# bytes this router verified. If the file is absent, the deployment falls
	# back to fetching release_url on the server.
	option binary_path '/usr/lib/openfrp/openfrps'
	option release_url ''

# Example tunnels, both disabled. Copy and adapt rather than editing these.
#
# config tunnel
#	option name 'ssh'
#	option enabled '1'
#	option type 'tcp'
#	option local_ip '192.168.1.1'
#	option local_port '22'
#	option remote_port '6022'
#
# config tunnel
#	option name 'nas'
#	option enabled '1'
#	option type 'http'
#	option local_ip '192.168.1.100'
#	option local_port '80'
#	# A "*" label matches exactly one level, at any depth:
#	#   *.aaa.com     matches www.aaa.com  but not x.bb.aaa.com
#	#   *.bb.aaa.com  matches x.bb.aaa.com
#	list domains 'aaa.com'
#	list domains 'www.aaa.com'
#	list domains '*.aaa.com'
#	# Terminating TLS at the server needs a certificate bound to the tunnel.
#	# The id is the one shown on the Certificates page; only a bound tunnel
#	# has its certificate pushed up.
#	option tls_mode 'terminate'
#	option cert_id '1'
