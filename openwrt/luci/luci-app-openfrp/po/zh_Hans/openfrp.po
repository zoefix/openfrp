msgstr "已保存的凭据不会显示。留空则保持原值。"

msgid "TLS handling"
msgstr "TLS 处理方式"

msgid "TLS on the control connection"
msgstr "控制连接启用 TLS"

msgid "TTL"
msgstr "TTL"

