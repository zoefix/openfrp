#
# OpenFrp client configuration.
#
# Structured data — DNS accounts, certificate orders, resolution records —
# lives in SQLite rather than here. UCI holds what an operator edits by hand
# and what should survive a firmware backup.
#

config global 'global'
	option enabled '0'
	option log_level 'info'

# One section per server. The name is local to this router and is what a
# tunnel points at; the server never sees it. A tunnel naming none belongs to
# the first, so a single-server setup needs no cross-references.
config server 'server'
	option addr ''
	option port '7000'
	option token ''
	# tcp | kcp | quic | websocket
	option protocol 'tcp'
	# Multiplexing is off by default, unlike frp. Every tunnel gets its own
	# TCP connection, which keeps the kernel zero-copy path reachable and
	# stops one lost packet from stalling every tunnel at once. Enable only
	# if socket count matters more than throughput.
	option mux '0'
	option pool_count '8'
	option tls_enable '0'

	# Provisioning settings live with the server they provision, so a router
	# with several keeps each one's SSH details alongside it.
	#
	# ssh_pass is stored so a deployment can run with nobody at the keyboard.
	# It used to be deliberately absent — asked for each time and passed
	# straight to the job so it never reached disk — and that is the right
	# trade for a deployment somebody starts by hand. It is the wrong one for
	# an update that installs itself, which has no one to ask.
	#
	# What it costs, plainly: this is a plaintext password for a remote root
	# account. /etc/config/openfrp is chmod 600 and uci preserves that across a
	# commit, so it is root-only on the router — but root on the router is then
	# root on every server listed here, and the password is carried in any
	# firmware backup taken of this device. A key with ssh_auth=key is the
	# better shape if the servers can be given one, because a key can be
	# restricted at the far end and a password cannot.
	#
	# ssh_auth: password | key
	option ssh_host ''
	option ssh_port '22'
	option ssh_user 'root'
	option ssh_auth 'password'
	option ssh_pass ''
	option ssh_key_path ''
	option host_fingerprint ''
	# Uploaded to the remote host. Uploading beats downloading: it works on a
	# server with no outbound internet and installs the exact bytes this router
	# verified. If the file is absent, the deployment fetches release_url.
	option binary_path '/usr/lib/openfrp/openfrps'
	option release_url ''

# A second server would look like this, and a tunnel would name it:
#
# config server 'backup'
#	option addr '198.51.100.7'
#	option port '7000'
#	option token ''

# Example tunnels, both disabled. Copy and adapt rather than editing these.
#
# config tunnel
#	option name 'ssh'
#	option enabled '1'
#	option type 'tcp'
#	option local_ip '192.168.1.1'
#	option local_port '22'
#	option remote_port '6022'
#
# config tunnel
#	option name 'nas'
#	option enabled '1'
#	option type 'http'
#	option local_ip '192.168.1.100'
#	option local_port '80'
#	# A "*" label matches exactly one level, at any depth:
#	#   *.aaa.com     matches www.aaa.com  but not x.bb.aaa.com
#	#   *.bb.aaa.com  matches x.bb.aaa.com
#	list domains 'aaa.com'
#	list domains 'www.aaa.com'
#	list domains '*.aaa.com'
#	# Terminating TLS at the server needs a certificate bound to the tunnel.
#	# The id is the one shown on the Certificates page; only a bound tunnel
#	# has its certificate pushed up.
#	option tls_mode 'terminate'
#	option cert_id '1'
