{
  "server_addr": "openfrps",
  "server_port": 7000,
  "token": "dev-token-not-for-production",
  "name": "dev-client",
  "transport": {
    "protocol": "tcp",
    "mux": false,
    "pool_count": 8,
    "heartbeat_interval": "10s",
    "heartbeat_timeout": "45s"
  },
  "tunnels": [
    {
      "name": "web",
      "enabled": true,
      "type": "tcp",
      "local_ip": "service",
      "local_port": 80,
      "remote_port": 6080
    }
  ],
  "log": {
    "level": "debug",
    "format": "text"
  }
}
