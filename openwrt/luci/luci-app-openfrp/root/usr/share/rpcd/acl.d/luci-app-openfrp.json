{
	"luci-app-openfrp": {
		"description": "Grant access to OpenFrp configuration, status, DNS, certificates and server provisioning",

		"read": {
			"ubus": {
				"luci.openfrp": [
					"status",
					"job_status",
					"log_tail",
					"update_check"
				],
				"luci": [ "setInitAction" ]
			},
			"uci": [ "openfrp" ],
			"file": {
				"/etc/init.d/openfrp": [ "exec" ]
			}
		},

		"write": {
			"ubus": {
				"luci.openfrp": [
					"job_start",
					"job_cancel",
					"dns",
					"cert"
				]
			},
			"uci": [ "openfrp" ]
		}
	}
}
